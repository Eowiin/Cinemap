# API Cinemap (axum) et pages HTML (gabarit : www/index.html de la release, trouvé à côté
# du binaire). Les fichiers statiques du front sont servis directement par nginx.
# Installé dans /etc/systemd/system/ (voir docs/DEPLOY.md).
[Unit]
Description=Cinemap API
After=network.target

[Service]
User=cinemap
Group=cinemap
# DATABASE_URL, TMDB_API_KEY, BIND_ADDR, RUST_LOG
EnvironmentFile=/etc/cinemap/cinemap.env
# Crée /var/lib/cinemap (propriétaire cinemap) : la base y vit.
StateDirectory=cinemap
WorkingDirectory=/var/lib/cinemap
ExecStart=/opt/cinemap/current/cinemap serve
Restart=on-failure
RestartSec=2
# SIGTERM → fin des requêtes en cours (shutdown_signal) ; au-delà, SIGKILL.
TimeoutStopSec=15

# Durcissement : le processus ne peut écrire que dans /var/lib/cinemap.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
