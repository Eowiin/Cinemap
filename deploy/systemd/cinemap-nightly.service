# Séances de toute la France puis TMDB. Décision du 2026-10-12 (docs/PLAN.md, point 4) :
# J à J+2 chaque nuit, là où les séances bougent ; la semaine complète (J à J+6) la nuit du
# mardi au mercredi, quand les programmes de la nouvelle semaine ciné sont publiés. La purge
# n'efface que les séances passées : les jours J+3 à J+6 du mercredi restent jusqu'à ce que
# les nuits suivantes les rafraîchissent. Mesures et estimations : ~2 h à 2 h 30 les nuits
# à 3 jours, ~5 à 6 h le mercredi, à 1 req/s.
# Lancé par cinemap-nightly.timer ; à la main : systemctl start cinemap-nightly
[Unit]
Description=Cinemap : scrape des séances puis enrichissement TMDB
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cinemap
Group=cinemap
EnvironmentFile=/etc/cinemap/cinemap.env
StateDirectory=cinemap
WorkingDirectory=/var/lib/cinemap
# Les ExecStart d'un oneshot s'enchaînent ; si le scrape échoue, tmdb n'est pas lancé.
# 1 req/s : test IDF du 2026-10-09, ~1 000 requêtes pour un seul blocage (contre un toutes
# les ~300 requêtes à 3 req/s). Voir docs/ETAPE2.md.
# %%u : jour de la semaine (3 = mercredi). $$ et %% : un $ et un % littéraux pour le shell.
ExecStart=/bin/sh -c 'days=3; [ "$$(TZ=Europe/Paris date +%%u)" = 3 ] && days=7; exec /opt/cinemap/current/cinemap scrape --nightly --days "$$days" --interval-ms 1000'
ExecStart=/opt/cinemap/current/cinemap tmdb
# Laisse la priorité CPU / disque à l'API.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
