# Copié dans /etc/cinemap/cinemap.env (root:root, 600 : systemd le lit en root avant de lancer le service). Ne jamais versionner le vrai fichier.
DATABASE_URL=sqlite:/var/lib/cinemap/cinemap.db
TMDB_API_KEY=
# Port local, derrière nginx. À garder en accord avec deploy/nginx/cinemap.conf et deploy/activate.sh.
BIND_ADDR=127.0.0.1:11174
RUST_LOG=info
